<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- O app NÃO faz rastreamento (Opção A): anúncios no app são NÃO
       personalizados (npa=1), então não há linkagem com dados de terceiros
       para publicidade nem compartilhamento com data broker. -->
  <key>NSPrivacyTracking</key>
  <false/>

  <!-- Sem rastreamento => sem domínios de rastreamento declarados. -->
  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <!-- Tipos de dados coletados: declaração autoritativa fica no App Store Connect
       (App Privacy), montada a partir do nosso mapeamento. -->
  <key>NSPrivacyCollectedDataTypes</key>
  <array/>

  <!-- APIs de "motivo obrigatório" usadas pelo app (Capacitor usa UserDefaults). -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
